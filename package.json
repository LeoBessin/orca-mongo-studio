{
  "name": "orca-mongo-studio",
  "version": "1.3.0",
  "description": "Mongo Studio: a MongoDB client plugin for Orca",
  "scripts": {
    "types": "node dev/orca.mjs plugin types .",
    "build": "node dev/build.mjs",
    "build:watch": "node dev/build.mjs --watch",
    "typecheck": "npm run types --silent && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node dev/with-source-main.mjs plugin test .",
    "test:it": "MONGO_STUDIO_IT=1 node dev/with-source-main.mjs plugin test .",
    "test:enterprise": "MONGO_STUDIO_IT_ENTERPRISE=1 node dev/with-source-main.mjs plugin test .",
    "check": "npm run build && node dev/orca.mjs plugin check . && node dev/orca.mjs plugin validate ."
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1169.0",
    "kerberos": "^7.0.0",
    "mongodb": "^7.9.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.19.2",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "license": "MIT"
}
