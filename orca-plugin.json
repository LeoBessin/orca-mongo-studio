{
  "manifestVersion": 2,
  "id": "mongo-studio",
  "name": "Mongo Studio",
  "version": "1.0.3",
  "description": "Browse, query and edit MongoDB databases without leaving Orca: aggregation pipelines, a mongo shell, import and export, indexes, users and server status. Not affiliated with or endorsed by MongoDB, Inc.",
  "icon": "media/icon.webp",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/worker.mjs",
  "contributes": {
    "panels": [
      {
        "id": "mongo-studio",
        "title": "Mongo Studio",
        "icon": "database",
        "entry": "dist/panel.js",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "mongoStudio.newConnection",
        "title": "Mongo Studio: New connection"
      },
      {
        "id": "mongoStudio.importConnections",
        "title": "Mongo Studio: Import connections"
      },
      {
        "id": "mongoStudio.exportConnections",
        "title": "Mongo Studio: Export connections"
      },
      {
        "id": "mongoStudio.disconnectAll",
        "title": "Mongo Studio: Disconnect all"
      },
      {
        "id": "mongoStudio.showShellResults",
        "title": "Mongo Studio: Show shell results"
      },
      {
        "id": "mongoStudio.showTasks",
        "title": "Mongo Studio: Show saved tasks"
      }
    ],
    "keybindings": [
      {
        "command": "mongoStudio.showTasks",
        "key": "Mod+Alt+Shift+T"
      },
      {
        "command": "mongoStudio.showShellResults",
        "key": "Mod+Alt+Shift+R"
      }
    ],
    "customEditors": [
      {
        "id": "shell",
        "title": "Mongo Shell",
        "extensions": [
          ".mongodb.js"
        ],
        "entry": "src/editor/main.ts",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "shell-script",
        "title": "Mongo Studio: New shell script",
        "extension": ".mongodb.js",
        "template": "templates/new-script.mongodb.js"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/LeoBessin/orca-mongo-studio",
  "cover": {
    "path": "media/cover.webp",
    "alt": "Mongo Studio: a shell script in the Mongo Shell editor beside the panel showing its find results as a table"
  },
  "screenshots": [
    {
      "path": "media/shell-editor.webp",
      "alt": "The Mongo Shell editor with a script that counts, finds and aggregates orders, with Run and Run script buttons"
    },
    {
      "path": "media/shell-results.webp",
      "alt": "The panel Shell tab: find results as a sortable table, and an aggregation grouped by payment method"
    }
  ]
}
